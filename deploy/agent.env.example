# 复制到 /etc/liteoffice/agent.env，然后 chmod 600
# 这个文件不要提交到 Git。

# 留空 = mock 模式，不联网、不花钱；填真实 Key = 调 DeepSeek
DEEPSEEK_API_KEY=

# 模型（默认 deepseek/deepseek-chat）
LITEOFFICE_MODEL=deepseek/deepseek-chat

# 知识库 SQLite
LITEOFFICE_KB_DB=/var/lib/liteoffice/kb.db

# 日志
LITEOFFICE_LOG_FILE=/var/log/liteoffice/agent.log
LITEOFFICE_LOG_LEVEL=info

# 知识库写接口的保护令牌：建议改成随机串
# 设置后，写 KB 需要请求头 X-API-Token；读/检索不受影响
LITEOFFICE_ADMIN_TOKEN=change-me-to-a-random-string

# 单 IP 每分钟请求上限
LITEOFFICE_RATE_LIMIT=60
