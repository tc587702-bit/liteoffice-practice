# ===== Agent 服务配置示例 =====
# 用法：复制本文件为 .env，填入自己的 key，然后 scripts/start-agent.ps1 会自动读取
# 不要提交 .env（已在 .gitignore 里）

# DeepSeek 开放平台的 key（https://platform.deepseek.com/api_keys）
# 不填也能启动：Agent 会走「启发式规划 + 抽取式回答」的离线模式，mock=true
DEEPSEEK_API_KEY=

# 用哪个模型；留空则用代码里的默认值 deepseek/deepseek-flash
# 常见可选：deepseek/deepseek-chat（更快、更适合中文长答）
LITEOFFICE_MODEL=

# 知识库 id（默认 lab，对应 data/kb.db）
LITEOFFICE_KB_ID=lab

# Agent 最大步数（默认 5）
LITEOFFICE_AGENT_MAX_STEPS=5
